{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "objectWrap": "preserve",
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.jsonc", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
